<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:prism="http://prismlibrary.com/"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
			 prism:Dialog.WindowStartupLocation="CenterScreen"
			 mc:Ignorable="d"
			 d:DesignWidth="750"
			 d:DesignHeight="690"
			 x:Class="ODProxl.UploadDialog">

	<Border Background="{DynamicResource MaterialCardBackgroundBrush}"
			CornerRadius="28"
			BoxShadow="0 0 0 0 #1A000000"
			MaxWidth="700"
			MaxHeight="690"
			ClipToBounds="True">

		<Grid RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto, Auto">

			<!-- 標題區（已加入自訂視窗按鈕） -->
			<Border Grid.Row="0"
					Background="{DynamicResource MaterialCardBackgroundBrush}"
					CornerRadius="28,28,0,0"
					Padding="36,12,20,20"
					PointerPressed="TitleBar_PointerPressed">

				<Grid ColumnDefinitions="Auto,*,Auto">
					<!-- 左側 Logo + 標題 -->
					<StackPanel Grid.Column="0"
								Orientation="Horizontal"
								Spacing="20"
								VerticalAlignment="Center">
						<avalonia:MaterialIcon Kind="CloudUploadOutline"
											   Foreground="{DynamicResource MaterialPrimaryBrush}"
											   Width="48" Height="48" />
						<TextBlock Text="發布新版本"
								   FontSize="26"
								   FontWeight="SemiBold"
								   Foreground="{DynamicResource MaterialForegroundBrush}"
								   VerticalAlignment="Center" />
					</StackPanel>

					<!-- 右側自訂視窗控制按鈕 -->
					<StackPanel Grid.Column="2"
								Orientation="Horizontal"
								VerticalAlignment="Top"
								Margin="0,8,8,0"
								Spacing="4">
						<Button x:Name="btnMin"
								Theme="{StaticResource MaterialFlatButton}"
								Width="44" Height="36"
								Foreground="#64748B"
								Click="BtnMin_Click">
							<avalonia:MaterialIcon Kind="Minus" Width="18" Height="18" />
						</Button>

						<Button x:Name="btnMax"
								Theme="{StaticResource MaterialFlatButton}"
								Width="44" Height="36"
								Foreground="#64748B"
								Click="BtnMax_Click">
							<avalonia:MaterialIcon x:Name="MaxIcon"
												   Kind="WindowMaximize"
												   Width="18" Height="18" />
						</Button>

						<Button x:Name="btnClose"
								Theme="{StaticResource MaterialFlatButton}"
								Width="44" Height="36"
								Foreground="#64748B"
								Click="BtnClose_Click">
							<Button.Styles>
								<Style Selector="Button:pointerover">
									<Setter Property="Background" Value="#EF4444"/>
									<Setter Property="Foreground" Value="White"/>
								</Style>
							</Button.Styles>
							<avalonia:MaterialIcon Kind="Close" Width="20" Height="20" />
						</Button>
					</StackPanel>
				</Grid>
			</Border>

			<!-- 目標平台 -->
			<StackPanel Spacing="9" Grid.Row="1">
				<TextBlock Text="目標平台" FontWeight="Medium" FontSize="15" />
				<ComboBox ItemsSource="{Binding AvailableRids}"
						  SelectedItem="{Binding SelectedRid, Mode=TwoWay}"
						  Classes="MaterialOutlined"
						  FontSize="16"
						  Height="56" />
			</StackPanel>

			<!-- 版本號 -->
			<StackPanel Spacing="9" Grid.Row="2">
				<TextBlock Text="版本號" FontWeight="Medium" FontSize="15" />
				<TextBox Text="{Binding Version, Mode=TwoWay}"
						 Watermark="例如：v1.2.3"
						 Classes="MaterialOutlined"
						 FontSize="16"
						 Height="56" />
			</StackPanel>

			<!-- 擴展檔案 -->
			<StackPanel Spacing="9" Grid.Row="3">
				<TextBlock Text="擴展檔案" FontWeight="Medium" FontSize="15" />
				<Grid ColumnDefinitions="*, Auto">
					<TextBox Grid.Column="0"
							 Text="{Binding DllFiles, Mode=TwoWay}"
							 Watermark="DLL 檔案路徑或清單"
							 Classes="MaterialOutlined"
							 FontSize="16"
							 Height="56" />
					<Button Grid.Column="1"
							Classes="MaterialFilled"
							Margin="16,0,0,0"
							Height="56"
							MinWidth="148"
							Click="SelectDllFiles_Click">
						<StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
							<avalonia:MaterialIcon Kind="FolderOpenOutline" Width="22" Height="22" />
							<TextBlock Text="選擇檔案" FontSize="15.5" FontWeight="Medium" />
						</StackPanel>
					</Button>
				</Grid>
			</StackPanel>

			<!-- 更新說明 -->
			<StackPanel Spacing="9" Grid.Row="4">
				<TextBlock Text="更新說明" FontWeight="Medium" FontSize="15" />
				<TextBox AcceptsReturn="True"
						 TextWrapping="Wrap"
						 Height="80"
						 MinHeight="80"
						 Text="{Binding UpdateDescription, Mode=TwoWay}"
						 Watermark="請詳細描述本次版本的主要更新內容、功能改進與修復項目..."
						 Classes="MaterialOutlined"
						 FontSize="16" />
			</StackPanel>

			<!-- 程式碼說明 -->
			<StackPanel Spacing="9" Grid.Row="5">
				<TextBlock Text="程式碼說明" FontWeight="Medium" FontSize="15" />
				<TextBox AcceptsReturn="True"
						 TextWrapping="Wrap"
						 Height="80"
						 MinHeight="80"
						 Text="{Binding CodeDescription, Mode=TwoWay}"
						 Watermark="本次提交的程式碼變更記錄、Commit 訊息或技術細節..."
						 Classes="MaterialOutlined"
						 FontSize="16" />
			</StackPanel>

			<!-- 底部按鈕 -->
			<Border Grid.Row="6"
					Background="{DynamicResource MaterialCardBackgroundBrush}"
					CornerRadius="0,0,28,28"
					Padding="36,24,36,32">
				<StackPanel Orientation="Horizontal"
							HorizontalAlignment="Right"
							Spacing="16">
					<Button Content="取消"
							Command="{Binding CancelCommand}"
							Classes="MaterialOutlined"
							MinWidth="128"
							Height="52"
							FontSize="16" />
					<Button Command="{Binding ConfirmCommand}"
							Classes="MaterialFilled"
							MinWidth="158"
							Height="52"
							FontSize="16">
						<StackPanel Orientation="Horizontal">
							<avalonia:MaterialIcon Kind="CloudUploadOutline"
												   Width="20" Height="20"
												   Margin="0,0,8,0" />
							<TextBlock Text="確認發布"/>
						</StackPanel>
					</Button>
				</StackPanel>
			</Border>
		</Grid>
	</Border>
</UserControl>