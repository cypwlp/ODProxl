<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dialogs="using:ODProxl.ViewModels.Dialogs"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:md="clr-namespace:Material.Styles.Controls;assembly=Material.Styles"
             mc:Ignorable="d"
             d:DesignWidth="420"
             d:DesignHeight="580"
             x:DataType="dialogs:LoginDialogViewModel"
             prism:Dialog.WindowStartupLocation="CenterScreen"
             x:Class="ODProxl.Dialogs.LoginDialog">

    <Grid Background="#F8FAFC">
        <!-- 背景裝飾圓形 -->
        <Canvas IsHitTestVisible="False">
            <Ellipse Width="220" Height="220" Fill="#4F46E5" Opacity="0.06" Canvas.Left="-80" Canvas.Top="-60"/>
            <Ellipse Width="280" Height="280" Fill="#10B981" Opacity="0.05" Canvas.Left="520" Canvas.Top="280"/>
            <Ellipse Width="180" Height="180" Fill="#6366F1" Opacity="0.04" Canvas.Left="300" Canvas.Top="420"/>
        </Canvas>

        <!-- 主要登入卡片 -->
        <Border Width="420" Height="580"
                Background="White"
                CornerRadius="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                BoxShadow="0 20 40 0 #1E293B20"
                ClipToBounds="True">

            <Grid>

                <!-- 窗口控制按鈕 -->
                <StackPanel HorizontalAlignment="Right" 
                            VerticalAlignment="Top" 
                            Orientation="Horizontal" 
                            Margin="0,8,8,0" 
                            Spacing="4">
                    <Button x:Name="btnMin" 
                            Theme="{StaticResource MaterialFlatButton}" 
                            Width="44" Height="36" 
                            Foreground="#64748B" 
                            Click="BtnMin_Click">
                        <avalonia:MaterialIcon Kind="Minus" Width="18" Height="18" />
                    </Button>
                    <Button x:Name="btnMax" 
                            Theme="{StaticResource MaterialFlatButton}" 
                            Width="44" Height="36" 
                            Foreground="#64748B" 
                            Click="BtnMax_Click">
                        <avalonia:MaterialIcon x:Name="MaxIcon" Kind="WindowMaximize" Width="18" Height="18" />
                    </Button>
                    <Button x:Name="btnClose" 
                            Theme="{StaticResource MaterialFlatButton}" 
                            Width="44" Height="36" 
                            Foreground="#64748B" 
                            Click="BtnClose_Click">
                        <Button.Styles>
                            <Style Selector="Button:pointerover">
                                <Setter Property="Background" Value="#EF4444"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Style>
                        </Button.Styles>
                        <avalonia:MaterialIcon Kind="Close" Width="20" Height="20" />
                    </Button>
                </StackPanel>

                <!-- 表單主要內容 -->
                <Grid Margin="48,64,48,48" RowDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto">

                    <!-- 標題區域 -->
                    <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,36" Spacing="12">
                        <Border Width="72" Height="72" Background="#4F46E5" CornerRadius="36" Margin="0,0,0,8"/>
                        <TextBlock Text="拓脈匙目標檢測系統"
                                   FontSize="28"
                                   FontWeight="SemiBold"
                                   Foreground="#1E293B"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="請輸入您的憑證以繼續"
                                   FontSize="14.5"
                                   Foreground="#64748B"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- 用戶名 -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,20" Spacing="6">
                        <TextBlock Text="用戶名" 
                                   FontSize="13.5" 
                                   FontWeight="Medium" 
                                   Foreground="#475569"/>
                        <Border Background="#F8FAFC" CornerRadius="10" Padding="3">
                            <TextBox x:Name="UserNameTextBox"
                                     Text="{Binding UserName, Mode=TwoWay}"
                                     FontSize="15"
                                     Background="Transparent"
                                     BorderThickness="1"
                                     CornerRadius="8"
                                     Padding="16,13"
                                     KeyDown="UserNameTextBox_KeyDown">
                                <TextBox.Styles>
                                    <Style Selector="TextBox:focus">
                                        <Setter Property="BorderBrush" Value="#4F46E5"/>
                                        <Setter Property="Background" Value="White"/>
                                    </Style>
                                </TextBox.Styles>
                            </TextBox>
                        </Border>
                    </StackPanel>

                    <!-- 密碼 -->
                    <StackPanel Grid.Row="2" Margin="0,0,0,20" Spacing="6">
                        <Grid>
                            <TextBlock Text="密碼" 
                                       FontSize="13.5" 
                                       FontWeight="Medium" 
                                       Foreground="#475569"/>
                            <TextBlock HorizontalAlignment="Right" 
                                       Text="忘記密碼？"
                                       FontSize="13" 
                                       Foreground="#4F46E5" 
                                       Cursor="Hand"
                                       VerticalAlignment="Center"/>
                        </Grid>
                        <Border Background="#F8FAFC" CornerRadius="10" Padding="3">
                            <TextBox x:Name="PasswordTextBox"
                                     Text="{Binding Password, Mode=TwoWay}"
                                     FontSize="15"
                                     Background="Transparent"
                                     BorderThickness="1"
                                     CornerRadius="8"
                                     PasswordChar="*"
                                     Padding="16,13"
                                     KeyDown="PasswordTextBox_KeyDown">
                                <TextBox.Styles>
                                    <Style Selector="TextBox:focus">
                                        <Setter Property="BorderBrush" Value="#4F46E5"/>
                                        <Setter Property="Background" Value="White"/>
                                    </Style>
                                </TextBox.Styles>
                            </TextBox>
                        </Border>
                    </StackPanel>

                    <!-- 記住我 -->
                    <CheckBox Grid.Row="3" 
                              Content="記住我"
                              FontSize="14" 
                              Foreground="#64748B" 
                              Margin="0,4,0,12"/>

                    <!-- 按鈕區域 -->
                    <Grid Grid.Row="4" ColumnDefinitions="*,12,*" Margin="0,8,0,0">
                        <Button Grid.Column="0"
                                Command="{Binding LoginCommand}"
                                Content="登錄"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Foreground="White"
                                Background="#4F46E5"
                                CornerRadius="10"
                                Height="52"/>

                        <Button Grid.Column="2"
                                Command="{Binding ShowSetCommand}"
                                Content="設置"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Foreground="White"
                                Background="#64748B"
                                CornerRadius="10"
                                Height="52"/>
                    </Grid>
                    <Grid Grid.Row="5"/>

                </Grid>
                <md:SnackbarHost 
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Bottom"
                    Margin="24,0,24,32"
                    HostName="LoginSnackbarHost"
                    MaxWidth="380"
                    ZIndex="1000" />

            </Grid>
        </Border>
    </Grid>
</UserControl>